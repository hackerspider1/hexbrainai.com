# Public address of the site. Leave empty on the live server to use https://hexbrainai.com.
HEXBRAIN_PUBLIC_URL=

# Google sign-in, so people can create accounts and API keys.
# Create an "OAuth client ID" (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add this redirect address to it: <HEXBRAIN_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true to let only invited people create and use API keys. Admins (comma-separated email addresses) manage
# the list on /account; `pnpm access invite <email>` does the same from the command line.
HEXBRAIN_INVITE_ONLY=
HEXBRAIN_ADMINS=

# On the live site the AI endpoints always need a key. Set this to true to leave them open to everyone.
HEXBRAIN_OPEN_API=

# Optional: an owner key that always works on the AI endpoints.
HEXBRAIN_API_KEY=

# Optional: how many proxies sit in front of the app (default 1). Used to read each visitor's real address for request limits.
HEXBRAIN_PROXY_HOPS=

# Optional: a header in which your host passes the visitor's address (for example fly-client-ip). Only set it if visitors cannot send it themselves.
HEXBRAIN_CLIENT_IP_HEADER=

# Optional: comma-separated browser origins allowed to call /api/mcp from another site.
HEXBRAIN_ALLOWED_ORIGINS=

# Optional: only needed for `pnpm ingest:list`, which reads the report list from the official HackerOne API.
H1_API_USERNAME=
H1_API_TOKEN=
