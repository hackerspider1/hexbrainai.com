# Public address of the site. Leave empty on the live server to use https://hexbrainai.com.
HEXBRAIN_PUBLIC_URL=

# Google sign-in, so people can create accounts and API keys.
# Create an "OAuth client ID" (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add this redirect address to it: <HEXBRAIN_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# On the live site the AI endpoints always need a key. Set this to true to leave them open to everyone.
HEXBRAIN_OPEN_API=

# Optional: an owner key that always works on the AI endpoints.
HEXBRAIN_API_KEY=

# Optional: only needed for `pnpm ingest:list`, which reads the report list from the official HackerOne API.
H1_API_USERNAME=
H1_API_TOKEN=
