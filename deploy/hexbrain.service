[Unit]
Description=HexBrain web app
After=network.target

[Service]
User=hexbrain
Group=hexbrain
WorkingDirectory=/opt/hexbrain/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hexbrain
MemoryMax=3G

[Install]
WantedBy=multi-user.target
